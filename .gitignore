# ─── Dependencies ────────────────────────────────────────────────────────────
# Matches node_modules/ at any depth — no need to list subfolders separately
node_modules/

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.local

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Ignore all uploaded files but keep the folder structure via .gitkeep
public/uploads/*
!public/uploads/.gitkeep

# ─── Logs ────────────────────────────────────────────────────────────────────
# Winston log files — generated at runtime, rotated daily
logs/

# ─── Script artefacts ────────────────────────────────────────────────────────
# Machine-generated by scripts/ — not needed in git
scripts/process-progress.json
scripts/migration-log.json
scripts/migration-public-site-log.json
scripts/migration-vendors-portal-log.json

# ─── System files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db